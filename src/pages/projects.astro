---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Selected Projects</div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <ProjectCard
      number="01"
      category="Web Application"
      title="SkySync"
      img="/skysync.webp"
      imgWidth={980}
      imgHeight={557}
      desc="A web-based application that combines real-time weather data with personalized playlist generation to create customized music experiences."
      url="https://sky-sync-pi.vercel.app/"
      techStack={["React", "API", "JavaScript", "Frontend"]}
      browserFrame
    />

    <ProjectCard
      number="02"
      category="Data Visualization"
      title="Interactive Visualization Dashboards"
      img="/viz_dashboards.webp"
      imgWidth={980}
      imgHeight={522}
      desc="Explore wildfire patterns across Canada through interactive visualizations, including regional distribution, causes, yearly trends, and severity analysis."
      url="https://canadian-fire-visualization-mw5cggo2fpjppyn9vt9ufe.streamlit.app/"
      techStack={["Python", "Altair", "Data Visualization", "Data Analysis"]}
      browserFrame
    />

    <ProjectCard
      number="03"
      category="Desktop Application"
      title="Interactive Music Player with Rhythm Game"
      img="/rhythm_game.webp"
      imgWidth={980}
      imgHeight={617}
      desc="A Java Swing music player and rhythm game featuring playlist management, duplicate detection, basic playback controls, persistent save/load functionality, and score history."
      url="https://github.com/xhuang512/Interactive-Music-Player-with-Rhythm-Game-Mode"
      techStack={["Java", "Java Swing", "OOP"]}
    />

    <ProjectCard
      number="04"
      category="Database System"
      title="Urban Bike Infrastructure Maintenance System"
      img="/bike_db.webp"
      imgWidth={980}
      imgHeight={557}
      desc="A database-driven web application for managing shared bicycle networks through dedicated views for bicycle, technician, and maintenance management."
      url="https://github.com/xhuang512/Urban-Bike-Infrastructure-Maintenance-System"
      techStack={["Oracle", "Database", "SQL", "Web Application"]}
    />
  </div>
</BaseLayout>
