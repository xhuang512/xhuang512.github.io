---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Resume</div>
  </div>

  <div class="mb-6 text-justify opacity-80">
    Last updated: July 30, 2026
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <a href="/resume.pdf" target="_blank" class="btn btn-primary">
      View Resume
    </a>

    <a href="/resume.pdf" download class="btn btn-outline">
      Download Resume
    </a>
  </div>

  <div class="rounded-xl border border-base-300 overflow-hidden bg-base-100">
    <iframe
      src="/resume.pdf"
      title="Xinghao Huang Resume"
      class="block w-full h-[70vh] sm:h-[800px] lg:h-[900px] border-0"
    ></iframe>
  </div>
</BaseLayout>